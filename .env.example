# Required
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here

# Optional: LangSmith tracing turns on when this key is present
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sundesk-copilot

# Optional: password for document upload
ADMIN_API_KEY=change-me

# Optional overrides (defaults shown)
PINECONE_INDEX_NAME=sundesk-solar-rag
PINECONE_NAMESPACE=aravalli-solar-kb
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
